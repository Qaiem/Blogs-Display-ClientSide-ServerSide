{
    "version": 2,
    "functions": {
      "index.js": {
        "runtime": "nodejs20.x"
      }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
          },
      {
        "source": "/(.*)",
        "destination": "/$1"
      }
    ]
  }
  